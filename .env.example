# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meterflow_db?schema=public"

# Stripe Test Mode Keys (Use placeholders for safety, never commit real secrets)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Local / Pakistan Mock Mode (Set to true to use local mock Stripe adapter without active Stripe account)
MOCK_STRIPE=true

# Idempotency Cache TTL in seconds (e.g. 24 hours = 86400)
IDEMPOTENCY_TTL_SECONDS=86400
